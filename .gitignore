# Institutes chapter audio is hosted on Cloudflare R2 (audio.usmcmin.org), not in the repo.
docs/assets/institutes/audio/

# Transient fleet progress/done markers (kept on disk, just not git-tracked)
/.backfill-mark.py
/.backfill-progress.md
scripts/.generic_done.txt
scripts/.shiloh_done.txt

# LBCF + Catechism chapter audio hosted on Cloudflare R2, not in the repo.
docs/assets/lbcf/audio/
docs/assets/catechism/audio/

# MBT Bible chapter narration (Ruth/Esther pilot) hosted on Cloudflare R2, not in the repo.
docs/assets/bible/audio/

# MBT pipeline intermediates — regenerable from bin/mbt-chapter-kit.py + bin/mbt-fleet-draft.py
data/mbt-kits/
data/mbt-drafts/

# Written fresh by bin/approval_gate.py --enforce on every CI deploy and synced
# to R2 from the runner working tree. Tracking it would just create churn and
# merge conflicts on a file no human edits.
docs/data/approval-gate.json

# full-review round working files: cached church-page text stays local (2026-11-08)
data/full-review/rounds/*/observations.json

