{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(pip3 install -r requirements.txt:*)",
      "Bash(python3 -m pip install -r requirements.txt:*)",
      "Bash(node generate-church-pages.js:*)",
      "Bash(node generate-worship-pages.js:*)",
      "Bash(node scripts/build-directory-map.js:*)",
      "Bash(python3 scripts/build_state_shards.py:*)",
      "Bash(python3 scripts/build_denomination_shards.py:*)",
      "Bash(python3 bin/generate_sitemap.py:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Read(./docs/data/churches.json)",
      "Read(./docs/data/churches-index.json)",
      "Read(./docs/data/churches/**)",
      "Read(./docs/assets/verse-cache.json)",
      "Read(./docs/assets/audio/**)",
      "Read(./docs/assets/institutes/audio/**)",
      "Read(./docs/assets/media/**)",
      "Read(./docs/directory-networks.html)",
      "Read(./node_modules/**)",
      "Read(./**/*.mp3)",
      "Read(./**/*.mp4)",
      "Read(./**/*.m4a)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/session-start.sh\"" }
        ]
      }
    ]
  }
}
