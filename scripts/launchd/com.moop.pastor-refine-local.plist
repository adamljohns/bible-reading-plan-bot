<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Nightly zero-cloud-usage pastor enrichment for the MOOP church directory.
         Canonical copy lives in the repo at scripts/launchd/; installed copy at
         ~/Library/LaunchAgents/. Runs scripts/pastor-refine-local.sh in the
         detached autopilot worktree at 03:07 (staggered after the dictionary
         nightly). Silent on success; Telegram alert via notify-adam.sh on failure. -->
    <key>Label</key>
    <string>com.moop.pastor-refine-local</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/moop_bot_pro/bible-reading-plan-bot-autopilot/scripts/pastor-refine-local.sh</string>
    </array>
    <!-- 4 rounds/day (~100 churches attempted daily) per Adam 2026-07-03:
         "I don't want this to take years." Staggered off the dictionary nightly. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>7</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>7</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>7</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>7</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/moop_bot_pro/Library/Logs/pastor-refine-local.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/moop_bot_pro/Library/Logs/pastor-refine-local.launchd.log</string>
</dict>
</plist>
