{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usmcmin.org/schemas/dictionary-word-origins.schema.json",
  "title": "MOOP Dictionary optional Word Origins fields",
  "type": "object",
  "properties": {
    "origin_category": {
      "enum": ["bible", "marine", "navy", "army", "civil-war", "eponym", "civic", "americana", "trades", "weaponized"]
    },
    "origin_label": {
      "enum": ["attested", "disputed", "folk-myth"]
    },
    "origin_sources": {
      "type": "array",
      "items": {"type": "string", "format": "uri", "pattern": "^https?://"}
    },
    "origin_crosslist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["word-origins", "military-language", "weaponized-words"]}
    }
  },
  "additionalProperties": true
}
